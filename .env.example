NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres.project-ref:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Certificate the database server must match, read from the backend folder. Leave empty only
# for a database with a publicly trusted certificate; ssl settings in the URL are then used.
DATABASE_CA_PATH=certs/supabase-ca.crt
BETTER_AUTH_SECRET=change-me-to-32-plus-random-characters
BETTER_AUTH_URL=http://localhost:5173
RESEND_API_KEY=re_xxx
EMAIL_FROM=Drop <onboarding@resend.dev>
SENDER_KEY_SECRET=change-me-to-32-plus-random-characters
LOCATIONIQ_API_KEY=pk.xxx
# Folder the server serves at /tiles. Leave empty to use the tiles folder at the drop-app root.
TILES_DIR=

# Folder where photos are stored. Leave empty to use the uploads folder at the drop-app root.
UPLOADS_DIR=

# Contact address shown on the public Terms, Privacy and Safety pages. Built into the frontend,
# so it must be a role address (for example privacy@...), never a personal one.
VITE_CONTACT_EMAIL=hello@fundrstudio.com
