{
    "name": "drop-app",
    "private": true,
    "license": "UNLICENSED",
    "packageManager": "pnpm@10.32.1",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev:frontend": "pnpm --filter frontend dev",
        "dev:backend": "pnpm --filter backend dev",
        "build": "pnpm --filter frontend build && pnpm --filter backend build",
        "start": "pnpm --filter backend start",
        "lint": "pnpm -r lint",
        "typecheck": "pnpm --filter backend typecheck",
        "test": "pnpm --filter backend test",
        "db:generate": "pnpm --filter backend db:generate",
        "db:migrate": "pnpm --filter backend db:migrate",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "prettier": "3.9.10"
    }
}
